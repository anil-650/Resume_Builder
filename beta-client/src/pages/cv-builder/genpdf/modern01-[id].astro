---
import PrintLayout from "../../../layouts/PrintLayout.astro"
import yearMonth from "../../../utils/yearMonth.js"
import { generateCV } from "../../../utils/userGet.js"

// GET CV DETAILS
const cvt = Astro.url.pathname.split('/').pop()

// GET CV DETAILS
const cv = cvt.split('-').slice(1).join('-')

// GET CV DATA FROM BACK-END
const response = await generateCV(cv)
const data = await response.json()

const cv_container=[
'container',
'print:h-a4',
'print:w-a4',
'mx-auto',
'border-2',
'border-black',
// 'p-8',
'm-4',
'mt-0',
'h-a4',
'w-a4',
// Specific template styles after this
'font-sans',
'flex',
]

let p,exp,edu,o

if("personal" in data){
p = data.personal
}

if("experience" in data){
exp = data.experience
}

if("education" in data){
edu = data.education
}

if("others" in data){
o = data.others
}


// DEBUG

console.log(`---------- PERSONAL ------------`)
console.log(p)
console.log(`---------- EXPERIENCE ----------`)
console.log(exp)
console.log(`---------- EDUCATION -----------`)
console.log(edu)
console.log(`---------- OTHERS --------------`)
console.log(o)
console.log(`---------- END -----------------`)

---
<PrintLayout>
<div class:list={[cv_container]}>
	<div id="personal_key_skill" class="personal_key_skill" >
		<div class="name">
			<h1>{p.name}</h1>
		</div>
		<div class="contancts">
			<p>{p.saddr}</p>
			<p>{p.city}, {p.state}, {p.pincode}</p>
			<p>{p.email}</p>
			<p>({p.cc})-{p.mobile}</p>
		</div>
		<div>
			{p.introduction}
		</div>
		<div>
			<h2>Key Skills</h2>
			<div class="ul_container">
				<ul>

					{o.skills && o.skills.map(x=>(
					<li>{x}</li>
					))}

				</ul>
			</div>
		</div>
	</div>

	<div id="professonal_edu" class="professonal_edu" >
		<div>
			<h2>Professional Experience</h2>

			{ exp && exp.map(exp=>(
			<div class="cards">
				<h3>{exp.designation}</h3>
				<h4>
					{exp.company}, {exp.c_address} |
					{yearMonth(exp.joined)}-{(exp.departed === null ||
					exp.departed === '') ? 'Present' : yearMonth(exp.departed)}
				</h4>
				<div class="ul_container">
					<ul>
						{exp.achievements &&
						exp.achievements.filter(Boolean).length ? exp.achievements.map(x=>(
						<li>{x}</li>
						)) : null }
					</ul>
				</div>
			</div>
			))}

			<h2>Education</h2>

			{ edu && edu.map(edu=>(
			<div class="cards">
				<h3>{edu.course}</h3>
				<h4>
					{edu.institute}, {edu.i_address} |
					{yearMonth(edu.admission)}-{(edu.graduated === null ||
					edu.graduated === '') ? 'Present' : yearMonth(edu.graduated)}
				</h4>
				<div class="ul_container">
					<ul>
						{edu.achievements &&
						edu.achievements.filter(Boolean).length ? edu.achievements.map(x=>(
						<li>{x}</li>
						)) : null }
					</ul>
				</div>
			</div>
			))}

		</div>
	</div>
</div>
</PrintLayout>

<style>
	h1 {
		@apply text-6xl;
	}

	h2 {
		@apply text-3xl;
	}

	h3 {
		@apply text-xl;
	}

	h4 {
		@apply text-lg italic;
	}

	.personal_key_skill {
		@apply text-sm bg-gray-300 text-gray-600 w-[36%];
	}

	.professonal_edu {
		@apply text-sm text-gray-600;
	}

	.personal_key_skill > div , .professonal_edu > div {
		@apply p-4;
	}
	.name {
		@apply max-w-min leading-none;
	}

	.contancts {
		@apply container mx-auto;
	}

	.ul_container {
		@apply pl-2;
	}

	.cards {
		@apply my-2.5;
	}

	ul {
		@apply list-disc my-2;
	}
</style>
